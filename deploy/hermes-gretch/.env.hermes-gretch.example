# hermes-gretch environment — copy to repo root as `.env.hermes-gretch` and fill in.
#   cp deploy/hermes-gretch/.env.hermes-gretch.example .env.hermes-gretch
#
# This file is what makes Gretchen's instance HER instance. Fill every <...> with a
# value DEDICATED to hermes-gretch — never reuse Lamar's tokens, API user, or memory
# scope. Secrets live in 1Password → "RSG Infrastructure"; pull them at deploy time.
#
# (HERMES_AGENT_ID, HERMES_PERSONA_FILE, and HERMES_MEMORY_SCOPE are set in the
#  compose file, not here — they are identity, not secret.)

# ── Slack (dedicated "hermes-gretch" Slack app) ──────────────────────────────
SLACK_BOT_TOKEN=<xoxb-... hermes-gretch app Bot User OAuth token>
SLACK_APP_TOKEN=<xapp-... hermes-gretch app-level token, connections:write>
HERMES_BOT_USER_ID=<U... hermes-gretch's own Slack user id, so it skips its own posts>
# Gretchen's instance posts/persona-checks land in #gretchen-tasks:
HERMES_SLACK_COMMAND_CHANNEL=C0AMWAZBBJP
HERMES_SLACK_FALLBACK_CHANNEL=C0AMWAZBBJP

# ── Supabase (shared data hub — same project) ────────────────────────────────
SUPABASE_URL=<https://...supabase.co>
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# ── Supermemory (ISOLATED scope — see compose HERMES_MEMORY_SCOPE=hermes-gretch)
# Client interactions, open service items, and renewal context written by this
# instance are tagged scope:hermes-gretch and never bleed into Lamar's memory.
SUPERMEMORY_API_KEY=<supermemory api key>

# ── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=<openai key for the conversational agent>
# HERMES_OPENAI_MODEL=gpt-4.1-mini   # optional override

# ── Webhook auth (shared with Lamar's instance) ──────────────────────────────
# Generate once:  openssl rand -hex 32
# Store in 1Password → "RSG Infrastructure" (item: SERVICE_WEBHOOK_SECRET).
# After adding or changing this value, recreate the container so the new env is
# loaded:  docker compose up -d hermes-api   (restart does NOT reload env_file)
SERVICE_WEBHOOK_SECRET=<openssl rand -hex 32>

# ── NowCerts: INTENTIONALLY OMITTED ──────────────────────────────────────────
# Do NOT add NOWCERTS_* here. Gretchen's instance never touches the AMS directly;
# all policy/AMS writes go through the existing gated crm_write_queue worker.
