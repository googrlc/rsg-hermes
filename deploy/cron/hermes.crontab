# Hermes scheduled automations — source of truth.
#
# Installed into root's crontab by deploy/cron/install-cron.sh, which replaces
# everything between the markers below and preserves all other crontab entries
# (Elestio backups, maintenance, watchtower). Edit HERE, then re-run the
# installer — never hand-edit the live crontab. Run after every redeploy.
#
# Times are ET via CRON_TZ. All jobs are idempotent (dry-run/force guards or
# natural dedup), so an overlapping/retried run won't double-post or double-write.
#
# NowCerts sync schedule — re-enabled 2026-07-14 after Phase 0 dedup fix
# (migration 20260714200000 added UNIQUE constraints + collapsed the 58x fan-out).
# --sync-nowcerts  → Account Sync v2: NowCerts Insured → EspoCRM Account (upsert only, no deletes)
# --sync-policies  → Policy Sync v2:  NowCerts Policy  → EspoCRM Policy  (policies-only, no Account writes)
#
# >>> hermes automations (managed by deploy/cron/install-cron.sh) >>>
CRON_TZ=America/New_York
# RETIRED 2026-07-23 — EspoCRM decommissioned. --sync-nowcerts writes EspoCRM Accounts
# (nightly 400 PUT / 409 POST "EspoCRM request failed"). Disabled; no valid target.
# Account Sync v2 — daily 2:00am ET (NowCerts Insured → EspoCRM Account)
# 0 2 * * * cd /opt/rsg-hermes && docker compose run --rm hermes hermes --sync-nowcerts >> /root/hermes-cron.log 2>&1
# RETIRED 2026-07-23 — EspoCRM decommissioned. --sync-policies writes EspoCRM Policies. Disabled.
# Policy Sync v2  — daily 2:10am ET (NowCerts Policy → EspoCRM Policy; no Account writes)
# 10 2 * * * cd /opt/rsg-hermes && docker compose run --rm hermes hermes --sync-policies >> /root/hermes-cron.log 2>&1
# OPT-IN 2026-07-16 — Canonical book sync — daily 2:20am ET (BEFORE renewal refresh).
# Pulls live NowCerts insureds+policies into canonical_clients (key nowcerts_insured_guid)
# and canonical_policies (key policy_guid) — the book --renewal-refresh reads. This
# satisfies the "Dependency: canonical_policies freshness" note below (the book was
# CSV-frozen at 2026-06-10 with no refresher). Additive upsert-by-natural-key; never
# deletes; preserves the renewed_policy lineage pointer. Uncommenting is the deliberate
# go-live step. Dry-run to preview with zero writes: hermes --sync-canonical-book-dry-run
# ENABLED 2026-07-16 after a verified full run (+249 clients / +157 policies, 0 errors).
20 2 * * * cd /opt/rsg-hermes && docker compose run --rm hermes hermes --sync-canonical-book >> /root/hermes-cron.log 2>&1
# Commission ledger seed — daily 2:25am ET (after the book sync). Writes EXPECTED
# commission per commissionable policy into commission_ledger (NowCerts agency
# commission, rule fallback). Preserves statement-sourced actuals/reconciliation —
# only the expected side is refreshed. So every new/refreshed policy shows on the
# Commissions page automatically. Money-data but non-destructive (expected only).
25 2 * * * cd /opt/rsg-hermes && docker compose run --rm hermes hermes --sync-commissions >> /root/hermes-cron.log 2>&1
# Renewal eligibility refresh — daily 2:30am ET (after Policy Sync v2). Rebuilds
# renewal_candidates from the live book (canonical_policies + live NowCerts insured-active)
# via the centralized eligibility engine, then projects ELIGIBLE events -> project_85_renewals.
# Supabase-only, no AMS/client writes, idempotent. Dependency: canonical_policies freshness.
30 2 * * * cd /opt/rsg-hermes && docker compose run --rm hermes hermes --renewal-refresh >> /root/hermes-cron.log 2>&1
# Quotes → opportunities pipeline — daily 2:35am ET. Pulls NowCerts quote rows
# (Policy with isQuote=true) into the `opportunities` pipeline. Idempotent per
# client+LOB; never resets a human-advanced stage; additive. Full pull each run
# (safe — re-runs just backfill NowCerts ids on existing rows, no duplicates).
35 2 * * * cd /opt/rsg-hermes && docker compose run --rm hermes hermes --sync-quotes >> /root/hermes-cron.log 2>&1
# RETIRED 2026-07-23 — EspoCRM decommissioned. --email-triage was removed from the CLI in
# commit 967e8c5 ("remove ... --email-triage (dead Espo jobs)"); the current image errors with
# "unrecognized arguments: --email-triage". Outlook->intake now runs in the rsg-hermes-intake-worker
# service (hermes --run-intake-worker), not via cron. Disabled to stop 48 failed runs/day.
# Outlook -> intake triage — every 30 min, 2h lookback (idempotent via Hermes Triaged category)
# */30 * * * * cd /opt/rsg-hermes && docker compose run --rm hermes hermes --email-triage --email-provider ms365 --email-since-hours 2 >> /root/hermes-cron.log 2>&1
# Dashboard KPI history — daily 6:00am ET (Supabase dashboard_kpis, no Slack)
0 6 * * * cd /opt/rsg-hermes && docker compose run --rm hermes hermes --snapshot-kpis >> /root/hermes-cron.log 2>&1
# OPT-IN 2026-07-15 — Renewal Executor (Job Contract v2). Processes human-approved
# renewal jobs from outbound_sync_queue → NowCerts, idempotent (guarded claim), writes
# receipts to renewal_execution_receipts. Uncommenting is the deliberate go-live step
# (reverses the 7/13 on-demand scope-lock; v2 sanctions scheduled processing). Dry-run
# first to preview with zero side effects: hermes --renewal-executor --renewal-executor-dry-run
# */15 8-18 * * 1-5 cd /opt/rsg-hermes && docker compose run --rm hermes hermes --renewal-executor --renewal-executor-limit 5 >> /root/hermes-cron.log 2>&1
# OPT-IN — Renewal urgency re-grade — re-grades risk_status (urgency only) over eligible
# renewal_candidates. Secondary to --renewal-refresh (which already grades on rebuild); enable
# for a faster intraday urgency bump if wanted. No Slack.
# 30 7 * * * cd /opt/rsg-hermes && docker compose run --rm hermes hermes --renewal-classify >> /root/hermes-cron.log 2>&1
# Revenue sentinel — Project 85 daily briefing -> #the-boss, weekdays 8:00am ET
0 8 * * 1-5 cd /opt/rsg-hermes && docker compose run --rm hermes hermes --revenue-sentinel >> /root/hermes-cron.log 2>&1
# Renewal prep-task sweep for Gretchen — weekdays 8:15am ET (creates EspoCRM Tasks)
# 15 8 * * 1-5 cd /opt/rsg-hermes && docker compose run --rm hermes hermes --renewal-sweep >> /root/hermes-cron.log 2>&1
# Commission audit (Revenue Integrity) — Mondays 7:00am ET -> Slack
0 7 * * 1 cd /opt/rsg-hermes && docker compose run --rm hermes hermes --commission-audit >> /root/hermes-cron.log 2>&1
# End-of-month revenue scorecard — 1st of month 7:00am ET -> Slack
0 7 1 * * cd /opt/rsg-hermes && docker compose run --rm hermes hermes --eom-scorecard >> /root/hermes-cron.log 2>&1
# RETIRED 2026-07-23 — EspoCRM decommissioned. --changelog QUERIES EspoCRM for 24h changes
# and logs an EspoCRM Task (nightly 400 POST Task "validationFailure"). Both read + write are
# Espo-only, so the job has no valid target. Disabled.
# Nightly CRM changelog -> #the-boss — 8:00pm ET
# 0 20 * * * cd /opt/rsg-hermes && docker compose run --rm hermes hermes --changelog >> /root/hermes-cron.log 2>&1
# RETIRED 2026-07-23 — EspoCRM decommissioned. --espo-writeback reads EspoCRM Cases/Tasks
# (also "unrecognized arguments" since the 07-14 build dropped the flag). Disabled.
# Cases -> NowCerts task ledger write-back — daily 7:00pm ET (AMS = source of truth; additive, idempotent via Case.momentumTaskId)
# 0 19 * * * cd /opt/rsg-hermes && docker compose run --rm hermes hermes --espo-writeback >> /root/hermes-cron.log 2>&1
# <<< hermes automations <<<
