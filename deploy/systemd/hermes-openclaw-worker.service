[Unit]
Description=Hermes OpenClaw task worker (polls openclaw_task_queue)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/opt/hermes/rsg-hermes
EnvironmentFile=-/etc/hermes/hermes.env
ExecStart=/opt/hermes/rsg-hermes/.venv/bin/hermes --run-openclaw-worker --openclaw-poll-seconds 5
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
