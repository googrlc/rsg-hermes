// Trigger Cursor "RSG Data Quality Investigator" from a Zoho CRM custom button.
//
// ONE argument only — custom buttons resolve Record Id reliably; field merge
// syntax like ${Renewals.Policy_Number} is often passed through literally.
//
// Button argument mapping:
//   renewalId  → pick "Record Id" from merge-field picker (Renewals module)
//
// CRM Variables:
//   cursor_dqi_webhook_url
//   cursor_dqi_webhook_key

string automation.trigger_cursor_policy_investigation(String renewalId)
{
	webhookUrl = zoho.crm.getOrgVariable("cursor_dqi_webhook_url");
	webhookKey = zoho.crm.getOrgVariable("cursor_dqi_webhook_key");
	moduleApi = "Renewals";

	if(webhookUrl == null || webhookUrl == "")
	{
		return "ERROR: cursor_dqi_webhook_url CRM variable is not set";
	}
	if(webhookKey == null || webhookKey == "")
	{
		return "ERROR: cursor_dqi_webhook_key CRM variable is not set";
	}
	rid = ifnull(renewalId, "").trim();
	if(rid == "" || rid.startsWith("${"))
	{
		return "ERROR: renewalId is empty or merge field did not resolve — map Record Id from the merge-field picker, not typed ${...} text";
	}

	rec = zoho.crm.getRecordById(moduleApi, rid);
	if(rec == null || rec.isEmpty())
	{
		return "ERROR: could not load " + moduleApi + " record " + rid;
	}

	pn = ifnull(rec.get("Policy_Number"), "").trim();
	if(pn == "")
	{
		return "ERROR: Policy_Number is empty on renewal " + rid;
	}
	cn = ifnull(rec.get("Client_Name"), "").trim();
	lob = ifnull(rec.get("Line_of_Business"), "").trim();

	// Build JSON explicitly — Map body can produce invalid JSON for Cursor.
	pnEsc = pn.replaceAll("\\\\", "\\\\\\\\").replaceAll("\"", "\\\\\"");
	cnEsc = cn.replaceAll("\\\\", "\\\\\\\\").replaceAll("\"", "\\\\\"");
	lobEsc = lob.replaceAll("\\\\", "\\\\\\\\").replaceAll("\"", "\\\\\"");
	ridEsc = rid.replaceAll("\\\\", "\\\\\\\\").replaceAll("\"", "\\\\\"");

	jsonBody = "{\"policy_number\":\"" + pnEsc + "\"";
	if(cn != "")
	{
		jsonBody = jsonBody + ",\"client_name\":\"" + cnEsc + "\"";
	}
	if(lob != "")
	{
		jsonBody = jsonBody + ",\"line_of_business\":\"" + lobEsc + "\"";
	}
	jsonBody = jsonBody + ",\"source\":\"zoho_renewals\",\"zoho_record_id\":\"" + ridEsc + "\"}";

	headers = Map();
	headers.put("Content-Type", "application/json");
	headers.put("Authorization", "Bearer " + webhookKey);

	response = invokeurl
	[
		url :webhookUrl
		type :POST
		headers:headers
		body:jsonBody
	];

	return "Triggered Cursor DQ investigation for policy " + pn + " — response: " + response;
}
