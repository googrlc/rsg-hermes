// Renewals Desk — standalone function for Custom API "Cursor".
// Create this IN the existing renewals-desk app (Workflows → Functions).
// Return type: Map. Never calls NowCerts.
//
// UI fields:
//   Function name: cursor_api
//   Display name: Cursor
//   Return type: Map
//   Arguments (all string):
//     action, id, expected_result, note, policy_number,
//     desk_stage, disposition, producer_confirmed
//
// Paste the function body below into the editor (Creator already wraps
// map cursor_api(...) { }). action values:
//   ping | request_terms | prepare_options | client_follow_up | update_ams
//   | approve | dismiss | set_stage

ok = Map();
ok.put("ok", true);
err = Map();
err.put("ok", false);
op = trim(ifnull(action, ""));
if(op == "")
{
	err.put("error", "action is required");
	return err;
}
if(op == "ping")
{
	ok.put("app", "renewals-desk");
	ok.put("api", "Cursor");
	ok.put("message", "pong");
	return ok;
}
if(op == "approve")
{
	if(id == null || id == "")
	{
		err.put("error", "id is required");
		return err;
	}
	rec = zoho.crm.getRecordById("AMS_Write_Queue", id);
	if(rec == null || rec.get("id") == null)
	{
		err.put("error", "AMS_Write_Queue row not found");
		return err;
	}
	if(ifnull(rec.get("Object_Type"), "") != "renewal")
	{
		err.put("error", "approve is only for object_type=renewal");
		return err;
	}
	status = ifnull(rec.get("Status"), "");
	approvedBy = ifnull(rec.get("Approved_By"), "");
	awaiting = (status == "needs_approval") || (status == "queued" && approvedBy == "");
	if(!awaiting)
	{
		err.put("error", "row is not awaiting approval");
		return err;
	}
	upd = Map();
	upd.put("Approved_By", zoho.loginuserid);
	upd.put("Approved_At", zoho.currenttime);
	upd.put("Status", "queued");
	resp = zoho.crm.updateRecord("AMS_Write_Queue", id, upd);
	ok.put("result", resp);
	return ok;
}
if(op == "dismiss")
{
	if(id == null || id == "")
	{
		err.put("error", "id is required");
		return err;
	}
	rec = zoho.crm.getRecordById("Renewals", id);
	if(rec == null || rec.get("id") == null)
	{
		err.put("error", "Renewals row not found");
		return err;
	}
	pn = ifnull(policy_number, rec.get("Policy_Number"));
	if(pn == null || pn == "")
	{
		err.put("error", "policy_number is the dismiss key; refuse if missing");
		return err;
	}
	upd = Map();
	upd.put("Dismissed", true);
	zoho.crm.updateRecord("Renewals", id, upd);
	eventLookup = rec.get("Related_Renewal_Event");
	eventId = null;
	if(eventLookup != null && eventLookup != "")
	{
		eventId = ifnull(eventLookup.get("id"), eventLookup);
	}
	if(eventId != null && eventId != "")
	{
		ev = Map();
		ev.put("Eligibility", "excluded");
		zoho.crm.updateRecord("Renewal_Events", eventId, ev);
	}
	ok.put("result", "dismissed");
	ok.put("policy_number", pn);
	return ok;
}
if(op == "set_stage")
{
	if(id == null || id == "")
	{
		err.put("error", "id is required");
		return err;
	}
	rec = zoho.crm.getRecordById("Renewals", id);
	if(rec == null || rec.get("id") == null)
	{
		err.put("error", "Renewals row not found");
		return err;
	}
	deskStages = {"Identified", "Outreach Sent", "Quote Requested", "Proposal Sent", "Negotiating", "Closed"};
	oldStage = ifnull(rec.get("Desk_Stage"), "Identified");
	proposed = trim(ifnull(desk_stage, ""));
	here = deskStages.indexOf(oldStage);
	there = deskStages.indexOf(proposed);
	if(there < 0)
	{
		err.put("error", "unknown desk stage");
		return err;
	}
	if(there != here)
	{
		if(there == here + 1)
		{
			if(proposed == "Closed" && (disposition == null || disposition == ""))
			{
				err.put("error", "Closed requires a Disposition");
				return err;
			}
		}
		else if(there > here + 1)
		{
			err.put("error", "cannot skip desk stages");
			return err;
		}
		else if(trim(ifnull(producer_confirmed, "")) != "true")
		{
			err.put("error", "moving backward requires producer confirmation");
			return err;
		}
	}
	upd = Map();
	upd.put("Desk_Stage", proposed);
	if(disposition != null && disposition != "")
	{
		upd.put("Disposition", disposition);
	}
	resp = zoho.crm.updateRecord("Renewals", id, upd);
	ok.put("result", resp);
	ok.put("Desk_Stage", proposed);
	return ok;
}
allowed = {"request_terms", "prepare_options", "client_follow_up", "update_ams"};
if(!allowed.contains(op))
{
	err.put("error", "unknown renewal action");
	return err;
}
expected = trim(ifnull(expected_result, ""));
if(expected == "")
{
	err.put("error", "expected_result is required");
	return err;
}
if(id == null || id == "")
{
	err.put("error", "id is required");
	return err;
}
rec = zoho.crm.getRecordById("Renewals", id);
if(rec == null || rec.get("id") == null)
{
	err.put("error", "Renewals row not found");
	return err;
}
pn = ifnull(policy_number, rec.get("Policy_Number"));
hermesId = rec.get("Hermes_Renewal_ID");
payload = Map();
payload.put("action", op);
payload.put("renewal_id", hermesId);
payload.put("policy_number", pn);
payload.put("expected_result", expected);
payload.put("channel", "task");
if(note != null && note != "")
{
	payload.put("note", note);
}
queueAction = if(op == "update_ams", "update", "create");
row = Map();
row.put("Name", pn + " " + op);
row.put("Object_Type", "renewal");
row.put("Object_ID", pn);
row.put("Destination", "nowcerts");
row.put("Action", queueAction);
row.put("Payload", payload.toString());
row.put("Status", "needs_approval");
row.put("Attempt_Count", 0);
row.put("Related_Renewal", id);
resp = zoho.crm.createRecord("AMS_Write_Queue", row);
ok.put("result", resp);
ok.put("Status", "needs_approval");
return ok;
