# Slack outbound posting (sentinel, scorecards, alerts). Bot token only —
# the inbound Socket Mode listener is retired, so no app-level token.
SLACK_BOT_TOKEN=xoxb-
# Hermes' own bot user_id in Slack (skip own posts in #crm-entry listener).
HERMES_BOT_USER_ID=
HERMES_SENTINEL_SLACK_CHANNEL=D0B2PJYLGQG
HERMES_SENTINEL_GRETCHEN_USER_ID=
HERMES_SLACK_RETRIES=2
HERMES_SLACK_RETRY_SLEEP=1.0

# Slack Events API webhook (second app, Events API → /api/hermes/slack/crm-entry).
# n8n was decommissioned — webhook endpoints are handled by hermes-api directly.
# Signing Secret of the SECOND Slack app (the one configured for Events API).
SLACK_EVENTS_SIGNING_SECRET=

# Job-idempotency state (sentinel / commission-audit / EOM-scorecard watermarks)
# lives in the hermes-state volume at /var/lib/hermes, set via the
# HERMES_*_STATE_FILE overrides in docker-compose.yml. /app is read-only in the
# image — the .:/app bind mount was removed (#234) — so state must NOT resolve
# under /app. The relative .hermes/*.json defaults below are the fallback for
# non-containerized runs only; the compose overrides point them at the volume.

# LLM gateway — all Hermes completions route through LiteLLM.
# LiteLLM owns provider routing, fallback, budget caps, and cost logging.
# Set LITELLM_BASE_URL + LITELLM_API_KEY to point at your LiteLLM proxy.
# If unset, the client falls back to the OpenAI public API (HERMES_OPENAI_API_KEY).
LITELLM_BASE_URL=
LITELLM_API_KEY=
# Default model-group name resolved by LiteLLM (e.g. hermes_intake_default, gpt-4.1-mini).
HERMES_OPENAI_MODEL=gpt-4.1-mini

# Legacy direct-OpenAI fallback (used only when LITELLM_BASE_URL is unset).
OPENAI_API_KEY=
HERMES_OPENAI_API_KEY=

# Supabase dual-write (leads_staging + stg_slack_intake_notes) and Hermes Operations Center.
SUPABASE_URL=https://wibscqhkvpijzqbhjphg.supabase.co
SUPABASE_KEY=
# Service role key: full CRUD on all Hermes tables via RLS. Server-side only — never expose to browsers.
SUPABASE_SERVICE_ROLE_KEY=

# NowCerts AMS sync (hermes --sync-nowcerts → Insured→Account + Policy→Opportunity,
# via Supabase as golden record). Auth: POST /api/token grant_type=password.
# Initial backfill: hermes --sync-nowcerts   (dry-run: --sync-nowcerts-dry-run)
# Daily incremental cron uses --sync-nowcerts-since <ISO>.
NOWCERTS_API_URL=https://api.nowcerts.com
NOWCERTS_USERNAME=
NOWCERTS_PASSWORD=
# Optional alternate credential form (also accepted by HERMES_ROLE=write_in).
# NOWCERTS_API_KEY=

# Process role — orthogonal to HERMES_SERVICE. Defaults from the service name:
#   all/hub → write_in (requires NowCerts creds; use DB role hermes_write)
#   finance → finance_readout (forbids NowCerts creds; use DB role hermes_finance;
#             prefer a read-replica DATABASE_URL)
#   intake/renewals/carriers → mirror_reader (forbids NowCerts creds)
# HERMES_ROLE=
# HERMES_DB_USER=hermes_write

# Microsoft 365 email triage (app-only / client-credentials via Microsoft Graph).
# Entra app registration with Mail.ReadWrite APPLICATION permission (admin-consented).
# See docs/integrations/email-triage-365.md for the setup walkthrough.
MS365_TENANT_ID=
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
# Comma-separated mailbox UPNs to triage, e.g. lamar@risksolutionsgroup.net,intake@risksolutionsgroup.net
MS365_MAILBOXES=
# Mailbox the "Ask Hermes" email_search tool queries (falls back to the first
# MS365_MAILBOXES entry). Set to the owner's inbox for conversational email lookups.
HERMES_ASK_MAILBOX=lamar@risksolutionsgroup.net

# Gmail email triage (service account + domain-wide delegation via Gmail API).
# Requires the [gmail] extra: pip install -e '.[gmail]'
# See docs/integrations/email-triage-gmail.md for the setup walkthrough.
GMAIL_SA_KEY_PATH=/run/secrets/gmail-sa.json
# Comma-separated mailbox addresses to impersonate + triage.
GMAIL_MAILBOXES=

# Supermemory — Hermes "Holographic Memory" document library (per-client folders
# + freeform internal references). Same workspace Agent OS uses.
# See docs/integrations/document-library.md.
SUPERMEMORY_API_KEY=
SUPERMEMORY_BASE_URL=https://api.supermemory.ai
# Google Drive mirror (human-browsable copy). Reuses the Gmail service account;
# add scope https://www.googleapis.com/auth/drive to its domain-wide delegation.
HERMES_DRIVE_ROOT_FOLDER=Hermes Docs
# Drive owner — a real Google Workspace user whose Drive holds the docs
# (NOT the 365 mailbox). Falls back to the first GMAIL_MAILBOXES entry.
HERMES_DRIVE_SUBJECT=
# Set false to disable the Drive mirror (docs still save to Supermemory + index).
HERMES_DRIVE_MIRROR=true

# RSG tuning knobs.
HERMES_ACCOUNT_FEIN_ATTR=fein
HERMES_POLICY_ENTITY=Opportunity
HERMES_POLICY_ACCOUNT_ID_FIELD=accountId
HERMES_PREMIUM_FIELD=amount
HERMES_RENEWAL_ENTITY=Opportunity
HERMES_RENEWAL_DATE_FIELD=closeDate
HERMES_SCHEMA_MAP=schema_map.json
HERMES_SENTINEL_TIMEZONE=America/New_York
HERMES_SENTINEL_STALE_DAYS=14
HERMES_SENTINEL_RENEWAL_CHECKPOINTS=90,60,30
HERMES_SENTINEL_XDATE_DAYS=60
HERMES_SENTINEL_WHALE_PREMIUM=20000
HERMES_SENTINEL_STATE_FILE=.hermes/sentinel_state.json
HERMES_COMMISSION_AUDIT_CHANNEL=C0B1VN5FKB2
HERMES_COMMISSION_AUDIT_STATE_FILE=.hermes/commission_audit_state.json
HERMES_COMMISSION_TASK_ASSIGNEE_ID=
HERMES_EOM_SCORECARD_CHANNEL=C0B1VN5FKB2
HERMES_EOM_SCORECARD_STATE_FILE=.hermes/eom_scorecard_state.json
HERMES_NORTH_STAR_PREMIUM_GOAL=1000000
HERMES_COMMISSION_RECON_CHANNEL=C0B0L7RPVHD
HERMES_COMMISSION_RECON_RULE=any_difference
HERMES_COMMISSION_RECON_PERCENT_THRESHOLD=1
HERMES_COMMISSION_RECON_AMOUNT_THRESHOLD=25

# Hermes API bridge (hermes-api service)
HERMES_API_HOST=0.0.0.0
HERMES_API_PORT=8484
HERMES_API_TOKEN=
# Browser CORS allowlist (comma-separated exact origins, e.g.
# https://app.example.com,https://ops.example.com). Leave empty for no
# cross-origin browser access (default; server-to-server callers and the
# same-origin /command-center UI are unaffected). Never use "*" here — with
# credentials the middleware reflects the caller's Origin and exposes
# token-authenticated endpoints to any site.
HERMES_CORS_ALLOW_ORIGINS=
# Public base URL used to build status_url in /api/intake responses.
# Defaults to the request's host if unset.
HERMES_PUBLIC_BASE_URL=

# /api/intake (rsg-intake pipeline) — clients must send the same value in
# the X-RSG-API-Key header. Stored in 1Password vault "RSG Infrastructure".
RSG_INTAKE_API_KEY=

# Stage a NowCerts prospect create when an intake is committed. OFF unless set to
# 1/true/yes, and that default is the agency's rule rather than caution: an intake
# is a prospect, a prospect is not a record of insurance, and a book full of
# prospects who never bought is a book that means nothing. The insured reaches
# NowCerts when a deal on it is WON. Turn this on only for a migration or backfill.
HERMES_INTAKE_STAGES_AMS_INSURED=0

# Nextcloud — general agency document store over WebDAV (COIs, policies,
# proposals, correspondence, renewal reviews — not renewal-only). Hermes files
# via PUT/MKCOL to {URL}/remote.php/dav/files/{USER}/{BASE_PATH}/...
# Real values live ONLY here (gitignored) + 1Password "RSG Infrastructure";
# never commit credentials. Prefer a dedicated service user over admin/root.
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_BASE_PATH=

# ACORD licensed templates — the on-demand ACORD pack generator fills these.
# The forms are copyrighted, so the PDFs live on the box (pull from NowCerts /
# agency files), never in the repo. Point each var at the fillable template.
# HERMES_ACORD_125_126_TEMPLATE is the combined 125/126 (8-page) form.
# The *_FIELDMAP overrides reconcile AcroForm names if you swap a template revision.
HERMES_ACORD_125_126_TEMPLATE=
HERMES_ACORD_140_TEMPLATE=
HERMES_ACORD_130_TEMPLATE=       # Workers Compensation Application
HERMES_ACORD_131_TEMPLATE=       # Commercial Excess / Umbrella Section
HERMES_ACORD_137_TEMPLATE=       # Commercial Auto Section (applicant block; schedules pending)
# HERMES_ACORD_163_TEMPLATE=     # Driver Schedule — filler pending row-order QA
# HERMES_ACORD125_FIELDMAP=/path/to/acord125_fieldmap.json
# HERMES_ACORD126_FIELDMAP=/path/to/acord126_fieldmap.json
# HERMES_ACORD140_FIELDMAP=/path/to/acord140_fieldmap.json

# Executor scheduler (hermes-scheduler service) — runs intake+renewal executors
# every SCHEDULER_INTERVAL_SECONDS with single-instance locking, backoff/dead-letter,
# and #systems-check alerts. OFF by default TWO ways: the compose "scheduler" profile
# AND this flag. Enable only after controlled live-write verification.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=300
SCHEDULER_BATCH=10
# Slack channel id for scheduler failure / dead-letter / stalled-queue alerts.
HERMES_SYSTEMS_CHECK_CHANNEL=

# Public URL Copilot Studio uses for MCP challenge/keepalive (no trailing slash).
# Locked: https://hermes-mcp.risksolutionsgroup.net — see docs/copilot-mcp-egress-plan.md
MCP_PUBLIC_BASE_URL=

# Keep false for Tailscale/IP HTTPS unless the certificate chain matches.
HERMES_VERIFY_TLS=false

# Renewals module (hermes --renewal-sweep + POST /renewals/complete)
# Shared secret for the renewals webhook callers.
SERVICE_WEBHOOK_SECRET=
# Gretchen (renewal task assignee). Set the id to skip the live userName lookup.
HERMES_RENEWALS_GRETCHEN_USERNAME=gretchcoates
HERMES_RENEWALS_GRETCHEN_USER_ID=
# Slack channel overrides (defaults baked into hermes/renewals/config.py)
SLACK_GRETCHEN_TASKS=
SLACK_THE_BOSS=
SLACK_RSG_WINS=

# --- Renewal Cadence Engine (hermes/renewals/cadence.py) ---
# Kill switch — leave OFF until the 8 templates + first live cards are approved.
# Truthy: 1/true/yes/on. The scheduler plans but posts nothing while unset.
RENEWAL_CADENCE_ENABLED=
# Small vs. mid commercial split, on ACCOUNT-LEVEL total active premium (default 5000).
RENEWAL_SMALL_COMMERCIAL_MAX_ACCOUNT_PREMIUM=5000
